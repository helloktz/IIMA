<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <!-- Explicitly imported by both native projects before Cpp.Default.props. -->
    <ImportDirectoryBuildProps>false</ImportDirectoryBuildProps>
    <IimaRoot>$(MSBuildThisFileDirectory)</IimaRoot>
    <IimaVersion>0.1.0</IimaVersion>
    <PlatformToolset>v145</PlatformToolset>
    <VCToolsVersion>14.51.36231</VCToolsVersion>
    <WindowsTargetPlatformVersion>10.0.26100.0</WindowsTargetPlatformVersion>
    <WindowsTargetPlatformMinVersion>10.0.22000.0</WindowsTargetPlatformMinVersion>
    <NuGetVersion>8.0.0</NuGetVersion>
    <IimaPackagesDir>$(IimaRoot).deps\packages\</IimaPackagesDir>
    <OutDir>$(IimaRoot)artifacts\bin\$(Platform)\$(Configuration)\$(MSBuildProjectName)\</OutDir>
    <IntDir>$(IimaRoot)artifacts\obj\$(Platform)\$(Configuration)\$(MSBuildProjectName)\</IntDir>
  </PropertyGroup>
</Project>
