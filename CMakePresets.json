{
  "version": 6,
  "configurePresets": [
    {
      "name": "windows-x64",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/.build/cmake/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": true
      }
    },
    {
      "name": "debug",
      "inherits": "windows-x64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "inherits": "windows-x64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "jobs": 10
    },
    {
      "name": "release",
      "configurePreset": "release",
      "jobs": 10
    }
  ]
}
