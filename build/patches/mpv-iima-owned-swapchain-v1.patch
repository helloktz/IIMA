+
+// IIMA private extension. Keep the playback core locked until the synchronous
+// VO request completes: the selected VO cannot be replaced/destroyed meanwhile.
+struct iima_swapchain_request {
+    struct MPContext *mpctx;
+    void *chain;
+    int status;
+};
+
+static void iima_acquire_swapchain(void *opaque)
+{
+    struct iima_swapchain_request *req = opaque;
+    if (!req->mpctx->initialized) {
+        req->status = MPV_ERROR_UNINITIALIZED;
+        return;
+    }
+    struct vo *vo = req->mpctx->video_out;
+    if (vo && vo_control(vo, VOCTRL_IIMA_ACQUIRE_D3D11_SWAPCHAIN,
+                         &req->chain) == VO_TRUE && req->chain)
+        req->status = 0;
+}
+
+int mpv_iima_acquire_d3d11_swapchain_v1(mpv_handle *ctx, void **out)
+{
+    if (!out)
+        return MPV_ERROR_INVALID_PARAMETER;
+    *out = NULL;
+    if (!ctx)
+        return MPV_ERROR_INVALID_PARAMETER;
+    struct iima_swapchain_request req = {
+        .mpctx = ctx->mpctx,
+        .status = MPV_ERROR_PROPERTY_UNAVAILABLE,
+    };
+    run_locked(ctx, iima_acquire_swapchain, &req);
+    *out = req.chain;
+    return req.status;
