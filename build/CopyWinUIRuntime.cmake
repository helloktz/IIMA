file(STRINGS "${inventory}" entries)
foreach(entry IN LISTS entries)
    string(REPLACE "|" ";" paths "${entry}")
    list(GET paths 0 source)
    list(GET paths 1 relative_path)
    set(output "${destination}/${relative_path}")
    cmake_path(GET output PARENT_PATH output_dir)
    file(MAKE_DIRECTORY "${output_dir}")
    file(COPY_FILE "${source}" "${output}" ONLY_IF_DIFFERENT)
endforeach()
