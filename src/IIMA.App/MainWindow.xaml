<Window x:Class="IIMA.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:IIMA">
    <Grid x:Name="Root" Background="{ThemeResource IimaVideoBackgroundBrush}" RequestedTheme="Dark" AllowDrop="True">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
        <local:VideoSurface x:Name="VideoPanel" />
        <Border x:Name="FullscreenInformationBorder" Grid.Column="0" Visibility="Collapsed" Canvas.ZIndex="6"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16" MaxWidth="360"
                Background="{ThemeResource IimaOverlayBackgroundBrush}" CornerRadius="8" Padding="12" IsHitTestVisible="False">
            <StackPanel Spacing="6">
                <TextBlock x:Name="FullscreenInformationTitle" FontSize="18" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                    <TextBlock x:Name="FullscreenClockText" FontSize="18" AutomationProperties.Name="当前本地时间"/>
                    <TextBlock x:Name="FullscreenBatteryText" FontSize="14"/>
                </StackPanel>
            </StackPanel>
        </Border>
        <Border x:Name="BufferingOverlay" Grid.Column="0" Visibility="Collapsed" Canvas.ZIndex="7"
                HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="180" MaxWidth="300"
                Background="{ThemeResource IimaOverlayBackgroundBrush}" CornerRadius="8" Padding="16" IsHitTestVisible="False">
            <StackPanel Spacing="6">
                <ProgressRing x:Name="BufferingSpinner" IsActive="False" Width="32" Height="32"/>
                <TextBlock x:Name="BufferingTitleText" TextAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
                <ProgressBar x:Name="BufferingProgress" Minimum="0" Maximum="100" Visibility="Collapsed" AutomationProperties.Name="缓存填充百分比"/>
                <TextBlock x:Name="BufferingProgressText" TextAlignment="Center"/>
                <TextBlock x:Name="BufferingDetailsText" TextAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
        <Canvas x:Name="InteractiveCropCanvas" Background="Transparent" Visibility="Collapsed" Canvas.ZIndex="20">
            <Border x:Name="InteractiveCropRectangle" BorderBrush="Yellow" BorderThickness="2" IsHitTestVisible="False"/>
        </Canvas>
        <Border x:Name="InteractiveCropToolbar" Grid.Column="1" Background="{ThemeResource IimaPanelBackgroundBrush}" Padding="12"
                Visibility="Collapsed" Canvas.ZIndex="21">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="10">
                <TextBlock x:Name="InteractiveCropTitle" Text="交互裁剪" FontSize="22"/>
                <TextBlock Text="拖动边缘或角点调整；内部拖动移动；外部拖动新建。Enter确认，Esc取消。" TextWrapping="Wrap"/>
                <TextBlock x:Name="InteractiveCropStatus" TextWrapping="Wrap"/>
                <ComboBox x:Name="InteractiveCropAspect" Header="居中比例" SelectedIndex="0">
                    <ComboBoxItem Content="全画面"/><ComboBoxItem Content="4:3"/><ComboBoxItem Content="16:9"/>
                    <ComboBoxItem Content="16:10"/><ComboBoxItem Content="21:9"/><ComboBoxItem Content="3:2"/><ComboBoxItem Content="5:4"/>
                </ComboBox>
                <Button x:Name="InteractiveCropAspectButton" Content="应用比例到草稿"/>
                <NumberBox x:Name="InteractiveCropX" Header="X（源像素）" Minimum="0"/>
                <NumberBox x:Name="InteractiveCropY" Header="Y（源像素）" Minimum="0"/>
                <NumberBox x:Name="InteractiveCropWidth" Header="宽（源像素）" Minimum="1"/>
                <NumberBox x:Name="InteractiveCropHeight" Header="高（源像素）" Minimum="1"/>
                <Button x:Name="InteractiveCropNumbersButton" Content="更新坐标草稿"/>
                <CheckBox x:Name="InteractiveCropResume" Content="退出时恢复进入前的播放状态" IsChecked="True"/>
                <Button x:Name="InteractiveCropConfirmButton" Content="确认裁剪"/>
                <Button x:Name="InteractiveDelogoRemoveButton" Content="移除原去标志滤镜" Visibility="Collapsed"/>
                <Button x:Name="InteractiveCropCancelButton" Content="取消"/>
            </StackPanel>
            </ScrollViewer>
        </Border>
        <Button x:Name="ExitCompactOverlayButton" Content="返回播放器" Visibility="Collapsed"
                HorizontalAlignment="Right" VerticalAlignment="Top" Canvas.ZIndex="10"/>
        <TextBlock x:Name="EmptyLabel" Text="打开视频，开始播放" Foreground="{ThemeResource IimaTextBrush}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="24" />
        <Border x:Name="OSDBorder" Visibility="Collapsed" Background="{ThemeResource IimaOverlayBackgroundBrush}" Padding="12"
                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16,64,16,0" Canvas.ZIndex="5">
            <StackPanel Spacing="4" MinWidth="180">
                <TextBlock x:Name="OSDTitle" Foreground="{ThemeResource IimaTextBrush}" FontSize="20"/>
                <TextBlock x:Name="OSDDetail" Foreground="{ThemeResource IimaSecondaryTextBrush}"/>
                <ProgressBar x:Name="OSDProgress" Minimum="0" Maximum="1"/>
            </StackPanel>
        </Border>
        <Border x:Name="TopStatusBorder" Background="{ThemeResource IimaOverlayBackgroundBrush}" VerticalAlignment="Top" Padding="16">
            <TextBlock x:Name="StatusText" Text="正在初始化播放器…" Foreground="{ThemeResource IimaTextBrush}" TextWrapping="Wrap" />
        </Border>
        <Border x:Name="MusicHeader" Visibility="Collapsed" Canvas.ZIndex="6"
                Background="{ThemeResource IimaOverlayBackgroundBrush}" VerticalAlignment="Top" Margin="12,52,12,0" Padding="12">
            <StackPanel Spacing="4">
                <TextBlock x:Name="MusicTitleText" FontSize="20" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="MusicArtistText" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="MusicAlbumText" TextTrimming="CharacterEllipsis"/>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button x:Name="MusicReturnButton" Content="返回播放器"/>
                    <Button x:Name="MusicPlaylistButton" Content="显示列表"/>
                </StackPanel>
            </StackPanel>
        </Border>
        <Border x:Name="ScreenshotPreviewBorder" Visibility="Collapsed" Canvas.ZIndex="9"
                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16,64,16,0"
                Background="{ThemeResource IimaOverlayBackgroundBrush}" Padding="8">
            <StackPanel Spacing="6">
                <TextBlock Text="截图预览" Foreground="{ThemeResource IimaTextBrush}"/>
                <Image x:Name="ScreenshotPreviewImage" MaxWidth="300" MaxHeight="200" Stretch="Uniform"
                       AutomationProperties.Name="刚完成的截图预览"/>
                <StackPanel x:Name="ScreenshotPreviewActions" Orientation="Horizontal" Spacing="6" Visibility="Collapsed">
                    <Button x:Name="OpenScreenshotPreviewButton" Content="打开图片"/>
                    <Button x:Name="RevealScreenshotPreviewButton" Content="定位文件"/>
                </StackPanel>
                <Button x:Name="DismissScreenshotPreviewButton" Content="关闭预览"/>
            </StackPanel>
        </Border>
        <Border x:Name="ThumbnailPreviewBorder" Visibility="Collapsed" Canvas.ZIndex="8"
                VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,100"
                Background="{ThemeResource IimaOverlayBackgroundBrush}" Padding="6">
            <StackPanel Spacing="4">
                <Image x:Name="ThumbnailPreviewImage" Width="240" Height="135" Stretch="Uniform"/>
                <TextBlock x:Name="ThumbnailPreviewTime" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
        <Border x:Name="BottomControlsBorder" Background="{ThemeResource IimaOverlayBackgroundBrush}" VerticalAlignment="Bottom" Padding="12">
            <Grid ColumnSpacing="12" RowSpacing="6">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Slider x:Name="PositionSlider" Grid.ColumnSpan="4" Minimum="0" Maximum="1"
                        IsEnabled="False" AutomationProperties.Name="播放进度" />
                <Button x:Name="OpenButton" Grid.Row="1" Content="打开文件" AutomationProperties.Name="打开文件" />
                <Button x:Name="PauseButton" Grid.Row="1" Grid.Column="1" Content="播放" IsEnabled="False" />
                <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock x:Name="TimeLabel" Foreground="{ThemeResource IimaTextBrush}" VerticalAlignment="Center" Text="--:--"/>
                    <TextBlock Text="/" VerticalAlignment="Center"/>
                    <Button x:Name="TimeModeButton" Content="--:--" Padding="4,2" AutomationProperties.Name="切换总时长与剩余时间"/>
                </StackPanel>
                <Button x:Name="FullscreenButton" Grid.Row="1" Grid.Column="3" Content="全屏" />
            </Grid>
        </Border>
        <Border x:Name="PlayerSidebar" Grid.Column="1" Background="{ThemeResource IimaPanelBackgroundBrush}" Padding="12">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="播放列表" Foreground="{ThemeResource IimaTextBrush}" VerticalAlignment="Center"/>
                    <Button x:Name="AppendButton" Content="添加"/>
                    <Button x:Name="SavePlaylistButton" Content="保存"/>
                </StackPanel>
                <ListView x:Name="PlaylistView" Grid.Row="1" Foreground="{ThemeResource IimaTextBrush}" SelectionMode="Extended"
                          CanDragItems="True" AllowDrop="True" CanReorderItems="False"
                          AutomationProperties.Name="播放列表（Ctrl或Shift多选，可拖动排序）" />
                <StackPanel Grid.Row="2" Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button x:Name="SortPlaylistButton" Content="排序"/>
                        <Button x:Name="ShufflePlaylistButton" Content="随机排序"/>
                        <Button x:Name="ClearPlaylistButton" Content="清空"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button x:Name="PreviousButton" Content="上一项"/>
                        <Button x:Name="PlaySelectedButton" Content="播放"/>
                        <Button x:Name="NextButton" Content="下一项"/>
                    </StackPanel>
                    <TextBlock x:Name="PlaylistSelectionText" Text="未选择条目；Ctrl或Shift可多选" TextWrapping="Wrap"/>
                    <Button x:Name="DeletePlaylistFilesButton" Content="删除所选磁盘文件…" ToolTipService.ToolTip="区别于移除列表；系统优先使用回收站，不能回收时另行确认"/>
                    <Button x:Name="CancelPlaylistDeletionButton" Content="停止后续文件删除" IsEnabled="False"/>
                    <Button x:Name="QueueSelectedNextButton" Content="选中项接下来播放"/>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button x:Name="RemoveButton" Content="移除"/>
                        <Button x:Name="RevealPlaylistButton" Content="定位所选文件"/>
                        <Button x:Name="CopyPlaylistPathsButton" Content="复制所选路径" ToolTipService.ToolTip="含网络URL原文，可能含私密参数"/>
                        <Button x:Name="CopyPlaylistUrlsButton" Content="仅复制所选网络URL"/>
                        <Button x:Name="PastePlaylistPathsButton" Content="粘贴文件或路径到列表" ToolTipService.ToolTip="支持资源管理器文件/文件夹，或每行一个绝对路径/URL；插入首选项前，无选择则插入开头"/>
                        <Button x:Name="CancelPlaylistPasteButton" Content="取消待处理粘贴"/>
                        <Button x:Name="MoveUpButton" Content="上移"/>
                        <Button x:Name="MoveDownButton" Content="下移"/>
                    </StackPanel>
                </StackPanel>
                <ScrollViewer Grid.Row="3" MaxHeight="300" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button x:Name="NewWindowButton" Content="新建窗口"/>
                            <Button x:Name="NextWindowButton" Content="下个窗口"/>
                        </StackPanel>
                        <TextBlock x:Name="WindowCountText" Text="播放器窗口：1"/>
                        <Button x:Name="RevealFileButton" Content="在资源管理器中显示"/>
                        <Button x:Name="MusicModeButton" Content="音乐模式"/>
                        <Button x:Name="CompactOverlayButton" Content="切换悬浮小窗"/>
                        <Button x:Name="OpenUrlButton" Content="打开网络媒体…"/>
                        <DropDownButton Content="更多打开方式" AutomationProperties.Name="更多打开方式">
                            <DropDownButton.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem x:Name="OpenFileAlternativeItem" Text="反转窗口偏好打开文件…"/>
                                    <MenuFlyoutItem x:Name="OpenFolderItem" Text="打开文件夹…"/>
                                    <MenuFlyoutItem x:Name="OpenFolderAlternativeItem" Text="反转窗口偏好打开文件夹…"/>
                                    <MenuFlyoutItem x:Name="AppendFolderItem" Text="将文件夹追加到当前队列…"/>
                                    <MenuFlyoutSeparator/>
                                    <MenuFlyoutItem x:Name="OpenUrlAlternativeItem" Text="反转窗口偏好打开网络媒体…"/>
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button x:Name="RelativeSeekBackButton" Content="后退5秒" ToolTipService.ToolTip="遵循useExactSeek：relative/exact/auto"/>
                            <Button x:Name="RelativeSeekForwardButton" Content="前进5秒" ToolTipService.ToolTip="遵循useExactSeek：relative/exact/auto"/>
                            <Button x:Name="StepBackButton" Content="上一帧"/>
                            <Button x:Name="StepForwardButton" Content="下一帧"/>
                        </StackPanel>
                        <TextBlock x:Name="ABLoopLabel" Text="A: --:--  B: --:--"/>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button x:Name="ABLoopButton" Content="A-B 循环"/>
                            <Button x:Name="ClearABLoopButton" Content="清除 A-B"/>
                        </StackPanel>
                        <Expander Header="精确调整 A-B 端点" HorizontalAlignment="Stretch">
                            <StackPanel Spacing="6">
                                <TextBlock Text="先用 A-B 循环建立端点，再读取并分别调整秒数。允许 A 在 B 之后。" TextWrapping="Wrap"/>
                                <Button x:Name="LoadABDraftButton" Content="读取当前端点"/>
                                <NumberBox x:Name="ABPointABox" Header="A 点（秒）" Minimum="0" SpinButtonPlacementMode="Compact"/>
                                <Button x:Name="ApplyABPointAButton" Content="应用 A 点"/>
                                <NumberBox x:Name="ABPointBBox" Header="B 点（秒）" Minimum="0" SpinButtonPlacementMode="Compact"/>
                                <Button x:Name="ApplyABPointBButton" Content="应用 B 点"/>
                                <TextBlock x:Name="ABEditStatus" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Expander>
                        <ComboBox x:Name="VideoTrackBox" Header="视频轨道" PlaceholderText="尚无已确认选择" HorizontalAlignment="Stretch" AutomationProperties.Name="视频轨道"/>
                        <Button x:Name="CycleVideoTrackButton" Content="切换下一视频轨道"/>
                        <Button x:Name="CycleAudioTrackButton" Content="切换下一音轨"/>
                        <ComboBox x:Name="AudioBox" Header="音轨" HorizontalAlignment="Stretch" AutomationProperties.Name="音轨"/>
                        <Button x:Name="LoadExternalAudioButton" Content="载入外置音频…" IsEnabled="False"/>
                        <ComboBox x:Name="AudioEqualizerBox" Header="音频均衡预设" HorizontalAlignment="Stretch"/>
                        <Button x:Name="ApplyAudioEqualizerButton" Content="应用均衡预设"/>
                        <Button x:Name="RemoveAudioEqualizerButton" Content="移除音频均衡"/>
                        <Expander Header="自定义十段均衡" HorizontalAlignment="Stretch">
                            <StackPanel Spacing="6">
                                <StackPanel x:Name="EqualizerBandsPanel" Spacing="4"/>
                                <Button x:Name="LoadObservedEqualizerButton" Content="读取当前均衡"/>
                                <Button x:Name="ApplyCustomEqualizerButton" Content="应用编辑值"/>
                                <ComboBox x:Name="UserEqualizerBox" Header="我的预设"/>
                                <Button x:Name="LoadUserEqualizerButton" Content="载入编辑器"/>
                                <TextBox x:Name="UserEqualizerName" Header="预设名称" MaxLength="256"/>
                                <Button x:Name="SaveUserEqualizerButton" Content="另存预设"/>
                                <Button x:Name="RenameUserEqualizerButton" Content="重命名选中预设"/>
                                <Button x:Name="DeleteUserEqualizerButton" Content="删除选中预设"/>
                            </StackPanel>
                        </Expander>
                        <Button x:Name="CycleSubtitleTrackButton" Content="切换下一主字幕轨道"/>
                        <ComboBox x:Name="SubtitleBox" Header="字幕" HorizontalAlignment="Stretch" AutomationProperties.Name="字幕"/>
                        <Expander Header="副字幕" HorizontalAlignment="Stretch">
                            <StackPanel Spacing="6">
                                <ComboBox x:Name="SecondarySubtitleBox" Header="副字幕轨道" HorizontalAlignment="Stretch"/>
                                <CheckBox x:Name="SecondarySubtitlesVisibleCheck" Content="显示副字幕" IsThreeState="True"/>
                                <TextBlock x:Name="SecondarySubtitleStatus" TextWrapping="Wrap"/>
                                <Button x:Name="LoadSecondarySubtitleButton" Content="读取当前参数"/>
                                <NumberBox x:Name="SecondarySubtitleDelayBox" Header="延迟（秒）" Value="0" SmallChange="0.1"/>
                                <NumberBox x:Name="SecondarySubtitlePositionBox" Header="位置（0顶部，100底部）" Minimum="0" Maximum="150" Value="0"/>
                                <NumberBox x:Name="SecondarySubtitleScaleBox" Header="缩放" Minimum="0" Maximum="100" Value="1" SmallChange="0.1"/>
                                <Button x:Name="ApplySecondarySubtitleButton" Content="应用编辑参数" IsEnabled="False"/>
                                <Button x:Name="ResetSecondaryDelayButton" Content="重置副字幕延迟"/>
                                <TextBlock Text="参数不会在编辑中被自动覆盖，请先读取当前值。位置超过100可能截断字幕。" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Expander>
                        <TextBlock x:Name="SubtitleStyleWarning" TextWrapping="Wrap"/>
                        <Button x:Name="SubtitleButton" Content="加载字幕…"/>
                        <Button x:Name="MatchSubtitleButton" Content="匹配同目录字幕"/>
                        <Expander x:Name="OnlineSubtitleExpander" Header="在线字幕" HorizontalAlignment="Stretch">
                            <StackPanel Spacing="6">
                                <TextBlock Text="搜索把查询词、语言和凭据发送给选中的服务。OpenSubtitles可选影片哈希；Shooter必须发送当前本地影片的四段MD5指纹和查询词，不发送完整路径。不上传媒体文件；凭据不保存，下载只访问服务域名下的 HTTPS 链接。" TextWrapping="Wrap"/>
                                <ComboBox x:Name="OnlineSubtitleProviderBox" Header="服务" SelectedIndex="0">
                                    <ComboBoxItem Content="Assrt (api.assrt.net)"/>
                                    <ComboBoxItem Content="OpenSubtitles (api.opensubtitles.com)"/>
                                    <ComboBoxItem Content="Shooter (www.shooter.cn)"/>
                                </ComboBox>
                                <PasswordBox x:Name="OnlineSubtitleApiKeyBox" Header="OpenSubtitles 个人 API Key" MaxLength="512"/>
                                <PasswordBox x:Name="OnlineSubtitleTokenBox" Header="Assrt 令牌 / OpenSubtitles JWT（可选）" MaxLength="8192"/>
                                <TextBox x:Name="OnlineSubtitleLanguageBox" Header="OpenSubtitles 语言代码（如 en、zh-cn，可留空）" MaxLength="32"/>
                                <CheckBox x:Name="OnlineSubtitleHashCheck" Content="OpenSubtitles：发送当前本地影片哈希以提高匹配度"/>
                                <TextBlock Text="不使用 IINA 的服务凭据；OpenSubtitles 需自行提供 API Key，可选择以下窗口内存登录（不保存密码）。点击下载会消耗服务额度，即使随后取消或文件下载失败。" TextWrapping="Wrap"/>
                                <TextBox x:Name="OpenSubUsernameBox" Header="OpenSubtitles 用户名（可选登录）" MaxLength="256"/>
                                <PasswordBox x:Name="OpenSubPasswordBox" Header="OpenSubtitles 密码（只用于本次登录）" MaxLength="4096"/>
                                <TextBlock Text="点击登录会把用户名、密码和个人API Key发送至api.opensubtitles.com。仅在此窗口内存保留返回令牌及Key，不写入磁盘；登录后把手工Key/JWT框留空即可使用会话。关闭清除本地会话，不自动发退出请求。" TextWrapping="Wrap"/>
                                <Button x:Name="OpenSubLoginButton" Content="发送凭据并登录OpenSubtitles"/>
                                <Button x:Name="OpenSubLogoutButton" Content="清除本地会话并请求服务器退出"/>
                                <Button x:Name="OpenSubCancelLoginButton" Content="取消等待账户请求" IsEnabled="False"/>
                                <TextBlock x:Name="OpenSubAccountStatus" Text="未登录；仍可手动输入API Key/JWT搜索。" TextWrapping="Wrap"/>
                                <TextBox x:Name="OnlineSubtitleQueryBox" Header="搜索词（可修改）" MaxLength="512"/>
                                <Button x:Name="OnlineSubtitleUseTitleButton" Content="填入当前文件名"/>
                                <Button x:Name="OnlineSubtitleSearchButton" Content="发送查询"/>
                                <ListView x:Name="OnlineSubtitleResultsView" MaxHeight="240" SelectionMode="Single" AutomationProperties.Name="在线字幕搜索结果"/>
                                <Button x:Name="OnlineSubtitleDownloadButton" Content="下载并载入选中结果" IsEnabled="False"/>
                                <ComboBox x:Name="DownloadedSubtitleBox" Header="本窗口下载的字幕"/>
                                <Button x:Name="SaveOnlineSubtitleButton" Content="将选中字幕另存为…"/>
                                <Button x:Name="OnlineSubtitleCancelButton" Content="取消并清除令牌"/>
                                <TextBlock x:Name="OnlineSubtitleStatusText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                            </StackPanel>
                        </Expander>
                        <Button x:Name="ReloadSubtitlesButton" Content="重新加载外部字幕"/>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button x:Name="PreviousSubtitleButton" Content="上一句"/>
                            <Button x:Name="NextSubtitleButton" Content="下一句"/>
                        </StackPanel>
                        <Expander Header="字幕时间对齐" HorizontalAlignment="Stretch">
                            <StackPanel Spacing="6">
                                <TextBlock Text="将上一句或下一句字幕对齐到当前视频时刻；内嵌字幕受预读取范围限制。" TextWrapping="Wrap"/>
                                <Button x:Name="PreviousSubtitleTimingButton" Content="主字幕：对齐上一句"/>
                                <Button x:Name="NextSubtitleTimingButton" Content="主字幕：对齐下一句"/>
                                <Button x:Name="PreviousSecondaryTimingButton" Content="副字幕：对齐上一句"/>
                                <Button x:Name="NextSecondaryTimingButton" Content="副字幕：对齐下一句"/>
                                <TextBlock x:Name="SubtitleTimingStatus" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Expander>
                        <TextBox x:Name="SubtitleFontText" Header="字幕字体" Text="sans-serif"/>
                        <Button x:Name="ChooseSubtitleFontButton" Content="选择本地字体…"/>
                        <NumberBox x:Name="SubtitleFontSizeBox" Header="字幕字号" Value="55" Minimum="1" Maximum="9000"/>
                        <CheckBox x:Name="SubtitleBoldCheck" Content="粗体字幕" IsChecked="False"/>
                        <CheckBox x:Name="SubtitleItalicCheck" Content="斜体字幕" IsChecked="False"/>
                        <Button x:Name="ApplySubtitleStyleButton" Content="应用字体、字号和字形"/>
                        <TextBlock Text="主副字幕共享文字样式。以下是编辑草稿，不代表当前值。颜色为 #RRGGBB 或 #AARRGGBB，AA=00完全透明，FF不透明。" TextWrapping="Wrap"/>
                        <TextBox x:Name="SubtitleColorText" Header="文字颜色" Text="#FFFFFFFF" MaxLength="9"/>
                        <Button x:Name="ChooseSubtitleColorButton" Content="选择文字颜色…"/>
                        <Button x:Name="ApplySubtitleColorButton" Content="仅应用文字颜色"/>
                        <TextBox x:Name="SubtitleOutlineColorText" Header="描边颜色" Text="#FF000000" MaxLength="9"/>
                        <Button x:Name="ChooseSubtitleOutlineColorButton" Content="选择描边颜色…"/>
                        <NumberBox x:Name="SubtitleOutlineSizeBox" Header="描边宽度" Value="3" Minimum="0" Maximum="100"/>
                        <Button x:Name="ApplySubtitleOutlineButton" Content="应用描边颜色和宽度"/>
                        <TextBox x:Name="SubtitleBackgroundText" Header="背景/阴影颜色" Text="#00000000" MaxLength="9"/>
                        <Button x:Name="ChooseSubtitleBackgroundButton" Content="选择背景颜色…"/>
                        <Button x:Name="ApplySubtitleBackgroundButton" Content="仅应用背景颜色"/>
                        <TextBlock x:Name="SubtitleStyleObservedText" TextWrapping="Wrap"/>
