<Window x:Class="IIMA.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" Background="Black" RequestedTheme="Dark" AllowDrop="True">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
        <SwapChainPanel x:Name="VideoPanel" />
        <Button x:Name="ExitCompactOverlayButton" Content="返回播放器" Visibility="Collapsed"
                HorizontalAlignment="Right" VerticalAlignment="Top" Canvas.ZIndex="10"/>
        <TextBlock x:Name="EmptyLabel" Text="打开视频，开始播放" Foreground="White"
                   HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="24" />
        <Border x:Name="OSDBorder" Visibility="Collapsed" Background="#DD202020" Padding="12"
                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16,64,16,0" Canvas.ZIndex="5">
            <StackPanel Spacing="4" MinWidth="180">
                <TextBlock x:Name="OSDTitle" Foreground="White" FontSize="20"/>
                <TextBlock x:Name="OSDDetail" Foreground="LightGray"/>
                <ProgressBar x:Name="OSDProgress" Minimum="0" Maximum="1"/>
            </StackPanel>
        </Border>
        <Border x:Name="TopStatusBorder" Background="#DD202020" VerticalAlignment="Top" Padding="16">
            <TextBlock x:Name="StatusText" Text="正在初始化播放器…" Foreground="White" TextWrapping="Wrap" />
        </Border>
        <Border x:Name="BottomControlsBorder" Background="#DD202020" VerticalAlignment="Bottom" Padding="12">
            <Grid ColumnSpacing="12" RowSpacing="6">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Slider x:Name="PositionSlider" Grid.ColumnSpan="4" Minimum="0" Maximum="1"
                        IsEnabled="False" AutomationProperties.Name="播放进度" />
                <Button x:Name="OpenButton" Grid.Row="1" Content="打开文件" AutomationProperties.Name="打开文件" />
                <Button x:Name="PauseButton" Grid.Row="1" Grid.Column="1" Content="播放" IsEnabled="False" />
                <TextBlock x:Name="TimeLabel" Grid.Row="1" Grid.Column="2" Foreground="White" VerticalAlignment="Center" Text="--:-- / --:--" />
                <Button x:Name="FullscreenButton" Grid.Row="1" Grid.Column="3" Content="全屏" />
            </Grid>
        </Border>
        <Border x:Name="PlayerSidebar" Grid.Column="1" Background="#FF242424" Padding="12">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="播放列表" Foreground="White" VerticalAlignment="Center"/>
                    <Button x:Name="AppendButton" Content="添加"/>
                    <Button x:Name="SavePlaylistButton" Content="保存"/>
                </StackPanel>
                <ListView x:Name="PlaylistView" Grid.Row="1" Foreground="White" SelectionMode="Single"
                          AutomationProperties.Name="播放列表" />
                <StackPanel Grid.Row="2" Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button x:Name="SortPlaylistButton" Content="排序"/>
                        <Button x:Name="ShufflePlaylistButton" Content="随机排序"/>
                        <Button x:Name="ClearPlaylistButton" Content="清空"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button x:Name="PreviousButton" Content="上一项"/>
                        <Button x:Name="PlaySelectedButton" Content="播放"/>
                        <Button x:Name="NextButton" Content="下一项"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button x:Name="RemoveButton" Content="移除"/>
                        <Button x:Name="MoveUpButton" Content="上移"/>
                        <Button x:Name="MoveDownButton" Content="下移"/>
                    </StackPanel>
                </StackPanel>
                <ScrollViewer Grid.Row="3" MaxHeight="300" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="6">
                        <Button x:Name="RevealFileButton" Content="在资源管理器中显示"/>
                        <Button x:Name="CompactOverlayButton" Content="切换悬浮小窗"/>
                        <Button x:Name="OpenUrlButton" Content="打开网络媒体…"/>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button x:Name="StepBackButton" Content="上一帧"/>
                            <Button x:Name="StepForwardButton" Content="下一帧"/>
                        </StackPanel>
                        <TextBlock x:Name="ABLoopLabel" Text="A: --:--  B: --:--"/>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button x:Name="ABLoopButton" Content="A-B 循环"/>
                            <Button x:Name="ClearABLoopButton" Content="清除 A-B"/>
                        </StackPanel>
                        <ComboBox x:Name="AudioBox" Header="音轨" HorizontalAlignment="Stretch" AutomationProperties.Name="音轨"/>
                        <ComboBox x:Name="AudioEqualizerBox" Header="音频均衡预设" HorizontalAlignment="Stretch"/>
                        <Button x:Name="ApplyAudioEqualizerButton" Content="应用均衡预设"/>
                        <Button x:Name="RemoveAudioEqualizerButton" Content="移除音频均衡"/>
                        <ComboBox x:Name="SubtitleBox" Header="字幕" HorizontalAlignment="Stretch" AutomationProperties.Name="字幕"/>
                        <Button x:Name="SubtitleButton" Content="加载字幕…"/>
                        <Button x:Name="MatchSubtitleButton" Content="匹配同目录字幕"/>
                        <Button x:Name="ReloadSubtitlesButton" Content="重新加载外部字幕"/>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button x:Name="PreviousSubtitleButton" Content="上一句"/>
                            <Button x:Name="NextSubtitleButton" Content="下一句"/>
                        </StackPanel>
                        <TextBox x:Name="SubtitleFontText" Header="字幕字体" Text="sans-serif"/>
                        <NumberBox x:Name="SubtitleFontSizeBox" Header="字幕字号" Value="55" Minimum="1" Maximum="9000"/>
                        <CheckBox x:Name="SubtitleBoldCheck" Content="粗体字幕" IsChecked="False"/>
                        <Button x:Name="ApplySubtitleStyleButton" Content="应用字幕样式"/>
                        <NumberBox x:Name="SubtitleScaleBox" Header="字幕缩放" Value="1" Minimum="0.01" Maximum="100" SmallChange="0.1"/>
                        <NumberBox x:Name="SubtitlePositionBox" Header="字幕位置（0顶部，100底部）" Value="100" Minimum="0" Maximum="100"/>
                        <Button x:Name="ApplySubtitleLayoutButton" Content="应用字幕位置与缩放"/>
                        <Button x:Name="ScreenshotButton" Content="保存截图…"/>
                        <Button x:Name="CopyScreenshotButton" Content="复制视频截图"/>
                        <ComboBox x:Name="ChapterBox" Header="章节" HorizontalAlignment="Stretch" AutomationProperties.Name="章节"/>
                        <ComboBox x:Name="SpeedBox" Header="播放速度" HorizontalAlignment="Stretch" AutomationProperties.Name="播放速度"/>
                        <Slider x:Name="VolumeSlider" Header="音量" Minimum="0" Maximum="100" Value="100" AutomationProperties.Name="音量"/>
                        <TextBox x:Name="AspectText" Header="视频比例（例如 16:9）"/>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button x:Name="ApplyAspectButton" Content="应用比例"/>
                            <Button x:Name="ResetAspectButton" Content="原始比例"/>
                        </StackPanel>
                        <ComboBox x:Name="RotationBox" Header="旋转角度" SelectedIndex="0">
                            <ComboBoxItem Content="0°"/><ComboBoxItem Content="90°"/>
                            <ComboBoxItem Content="180°"/><ComboBoxItem Content="270°"/>
                        </ComboBox>
                        <Button x:Name="ApplyRotationButton" Content="应用旋转"/>
                        <TextBox x:Name="VideoFilterText" Header="视频滤镜" PlaceholderText="@iima_flip:flip"/>
                        <Button x:Name="ApplyFilterButton" Content="添加或替换滤镜"/>
                        <TextBox x:Name="VideoFilterLabelText" Header="要移除的滤镜标签" PlaceholderText="iima_flip"/>
                        <Button x:Name="RemoveFilterButton" Content="移除滤镜"/>
                        <CheckBox x:Name="PauseWhenOpenCheck" Content="打开后暂停"/>
                        <CheckBox x:Name="AutoPlayNextCheck" Content="自动播放下一项" IsChecked="True"/>
                        <CheckBox x:Name="MuteCheck" Content="静音"/>
                        <CheckBox x:Name="SubtitlesVisibleCheck" Content="显示字幕" IsChecked="True"/>
                        <NumberBox x:Name="MaxVolumeBox" Header="音量上限" Minimum="100" Maximum="1000" Value="100" SpinButtonPlacementMode="Compact"/>
                        <NumberBox x:Name="AudioDelayBox" Header="音频延迟（秒，正数延后）" Value="0" SmallChange="0.1" LargeChange="1" SpinButtonPlacementMode="Compact"/>
                        <NumberBox x:Name="SubtitleDelayBox" Header="字幕延迟（秒，正数延后）" Value="0" SmallChange="0.1" LargeChange="1" SpinButtonPlacementMode="Compact"/>
                        <ComboBox x:Name="RepeatModeBox" Header="播放循环" HorizontalAlignment="Stretch"/>
                        <ComboBox x:Name="ScreenshotModeBox" Header="截图内容" HorizontalAlignment="Stretch"/>
                        <Expander Header="高级播放与窗口偏好" HorizontalAlignment="Stretch">
                            <StackPanel x:Name="AdvancedSettingsPanel" Spacing="8"/>
                        </Expander>
                        <Expander Header="快捷键配置" HorizontalAlignment="Stretch">
                            <StackPanel Spacing="8">
                                <TextBlock Text="input.conf 格式。保存后立即生效；留空可取消全部快捷键。" TextWrapping="Wrap"/>
                                <TextBox x:Name="KeyBindingsEditor" AcceptsReturn="True" MinHeight="160" MaxHeight="320" TextWrapping="NoWrap" FontFamily="Consolas"/>
                                <Button x:Name="SaveKeyBindingsButton" Content="保存并应用"/>
                                <Button x:Name="ResetKeyBindingsButton" Content="恢复 Windows 默认快捷键"/>
                                <Button x:Name="ImportKeyBindingsButton" Content="导入 input.conf"/>
                                <Button x:Name="ExportKeyBindingsButton" Content="导出 input.conf"/>
                                <TextBlock x:Name="KeyBindingsStatus" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Expander>
                        <CheckBox x:Name="RecordHistoryCheck" Content="记录播放历史" IsChecked="True"/>
                        <CheckBox x:Name="ResumeCheck" Content="从上次位置继续" IsChecked="True"/>
                        <TextBlock Text="Windows 文件关联"/>
                        <Button x:Name="RegisterAssociationsButton" Content="注册为可选播放器"/>
                        <Button x:Name="DefaultAppsButton" Content="选择 Windows 默认应用…"/>
                        <Button x:Name="UnregisterAssociationsButton" Content="移除此副本的文件关联注册"/>
                        <TextBlock Text="注册不会更改默认应用；移动播放器目录后需重新注册。" TextWrapping="Wrap"/>
                        <TextBlock Text="历史记录"/>
                        <ListView x:Name="HistoryView" MaxHeight="160" SelectionMode="Single" AutomationProperties.Name="播放历史"/>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button x:Name="OpenHistoryButton" Content="打开历史"/>
                            <Button x:Name="ClearHistoryButton" Content="清空历史"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
