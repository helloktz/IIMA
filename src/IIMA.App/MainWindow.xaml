<Window x:Class="IIMA.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:IIMA">
    <Grid Background="{ThemeResource IimaPanelBackgroundBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <MenuBar x:Uid="ApplicationMenuBar" x:Name="ApplicationMenuBar" IsEnabled="False" RequestedTheme="Dark"/>
    <ContentControl x:Name="PlayerContent" Grid.Row="1" IsTabStop="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
    <Grid x:Name="Root" Background="{ThemeResource IimaVideoBackgroundBrush}" RequestedTheme="Dark" AllowDrop="True">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
        <local:VideoSurface x:Name="VideoPanel" />
        <Border x:Name="InitialWindowPanel" Visibility="Collapsed" Canvas.ZIndex="5"
                HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" MaxWidth="520" MaxHeight="520"
                Padding="20" Background="{ThemeResource IimaOverlayBackgroundBrush}" CornerRadius="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="10">
                    <TextBlock x:Uid="StartPlayback" FontSize="24"/>
                    <Button x:Uid="InitialOpenFileButton" x:Name="InitialOpenFileButton"/>
                    <Button x:Uid="InitialOpenUrlButton" x:Name="InitialOpenUrlButton"/>
                    <TextBlock x:Uid="RecentlyPlayed" FontSize="18"/>
                    <StackPanel x:Name="InitialRecentItems" Spacing="6"/>
                    <TextBlock x:Name="InitialRecentHint" TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
        <Border x:Name="FullscreenInformationBorder" Grid.Column="0" Visibility="Collapsed" Canvas.ZIndex="6"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16" MaxWidth="360"
                Background="{ThemeResource IimaOverlayBackgroundBrush}" CornerRadius="8" Padding="12" IsHitTestVisible="False">
            <StackPanel Spacing="6">
                <TextBlock x:Name="FullscreenInformationTitle" FontSize="18" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                    <TextBlock x:Uid="FullscreenClockText" x:Name="FullscreenClockText" FontSize="18"/>
                    <TextBlock x:Name="FullscreenBatteryText" FontSize="14"/>
                </StackPanel>
            </StackPanel>
        </Border>
        <Border x:Name="BufferingOverlay" Grid.Column="0" Visibility="Collapsed" Canvas.ZIndex="7"
                HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="180" MaxWidth="300"
                Background="{ThemeResource IimaOverlayBackgroundBrush}" CornerRadius="8" Padding="16" IsHitTestVisible="False">
            <StackPanel Spacing="6">
                <ProgressRing x:Name="BufferingSpinner" IsActive="False" Width="32" Height="32"/>
                <TextBlock x:Name="BufferingTitleText" TextAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
                <ProgressBar x:Uid="BufferingProgress" x:Name="BufferingProgress" Minimum="0" Maximum="100" Visibility="Collapsed"/>
                <TextBlock x:Name="BufferingProgressText" TextAlignment="Center"/>
                <TextBlock x:Name="BufferingDetailsText" TextAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
        <StackPanel x:Name="NetworkOpenPanel" Grid.Column="0" Visibility="Collapsed" Canvas.ZIndex="9"
                    HorizontalAlignment="Center" VerticalAlignment="Top" Margin="16,72,16,16" MaxWidth="380"
                    Background="{ThemeResource IimaOverlayBackgroundBrush}" Padding="16" Spacing="8">
            <TextBlock x:Name="NetworkOpenStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Uid="CancelNetworkOpenButton" x:Name="CancelNetworkOpenButton"/>
                <Button x:Uid="RetryNetworkOpenButton" x:Name="RetryNetworkOpenButton"/>
                <Button x:Uid="EditNetworkOpenButton" x:Name="EditNetworkOpenButton"/>
                <Button x:Uid="DismissNetworkOpenButton" x:Name="DismissNetworkOpenButton"/>
            </StackPanel>
        </StackPanel>
        <Canvas x:Name="InteractiveCropCanvas" Background="Transparent" Visibility="Collapsed" Canvas.ZIndex="20">
            <Border x:Name="InteractiveCropRectangle" BorderBrush="Yellow" BorderThickness="2" IsHitTestVisible="False"/>
        </Canvas>
        <Border x:Name="InteractiveCropToolbar" Grid.Column="1" Background="{ThemeResource IimaPanelBackgroundBrush}" Padding="12"
                Visibility="Collapsed" Canvas.ZIndex="21">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="10">
                <TextBlock x:Uid="InteractiveCropTitle" x:Name="InteractiveCropTitle" FontSize="22"/>
                <TextBlock x:Uid="DragsTheEdgeOrCornerPointAdjustment" TextWrapping="Wrap"/>
                <TextBlock x:Name="InteractiveCropStatus" TextWrapping="Wrap"/>
                <ComboBox x:Uid="InteractiveCropAspect" x:Name="InteractiveCropAspect" SelectedIndex="0">
                    <ComboBoxItem x:Uid="FullView"/><ComboBoxItem Content="4:3"/><ComboBoxItem Content="16:9"/>
                    <ComboBoxItem Content="16:10"/><ComboBoxItem Content="21:9"/><ComboBoxItem Content="3:2"/><ComboBoxItem Content="5:4"/>
                </ComboBox>
                <Button x:Uid="InteractiveCropAspectButton" x:Name="InteractiveCropAspectButton"/>
                <NumberBox x:Uid="InteractiveCropX" x:Name="InteractiveCropX" Minimum="0"/>
                <NumberBox x:Uid="InteractiveCropY" x:Name="InteractiveCropY" Minimum="0"/>
                <NumberBox x:Uid="InteractiveCropWidth" x:Name="InteractiveCropWidth" Minimum="1"/>
                <NumberBox x:Uid="InteractiveCropHeight" x:Name="InteractiveCropHeight" Minimum="1"/>
                <Button x:Uid="InteractiveCropNumbersButton" x:Name="InteractiveCropNumbersButton"/>
                <CheckBox x:Uid="InteractiveCropResume" x:Name="InteractiveCropResume" IsChecked="True"/>
                <Button x:Uid="InteractiveCropConfirmButton" x:Name="InteractiveCropConfirmButton"/>
                <Button x:Uid="InteractiveDelogoRemoveButton" x:Name="InteractiveDelogoRemoveButton" Visibility="Collapsed"/>
                <Button x:Uid="InteractiveCropCancelButton" x:Name="InteractiveCropCancelButton"/>
            </StackPanel>
            </ScrollViewer>
        </Border>
        <Button x:Uid="ExitCompactOverlayButton" x:Name="ExitCompactOverlayButton" Visibility="Collapsed"
                HorizontalAlignment="Right" VerticalAlignment="Top" Canvas.ZIndex="10"/>
        <Border x:Name="CompactOverlayControls" Visibility="Collapsed" Canvas.ZIndex="10"
                VerticalAlignment="Bottom" Margin="6" Padding="6" CornerRadius="6"
                Background="{ThemeResource IimaOverlayBackgroundBrush}">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                          HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="CompactTimeText" Text="--:-- / --:--" FontSize="12"/>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button x:Uid="CompactBackButton" x:Name="CompactBackButton" Padding="6,4"/>
                        <Button x:Uid="CompactPlayPauseButton" x:Name="CompactPlayPauseButton" Padding="6,4"/>
                        <Button x:Uid="CompactForwardButton" x:Name="CompactForwardButton" Padding="6,4"/>
                        <Button x:Uid="CompactPauseReturnButton" x:Name="CompactPauseReturnButton" Padding="6,4"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
        <TextBlock x:Uid="EmptyLabel" x:Name="EmptyLabel" Foreground="{ThemeResource IimaTextBrush}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="24" />
        <Border x:Name="OSDBorder" Visibility="Collapsed" Background="{ThemeResource IimaOverlayBackgroundBrush}" Padding="12"
                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16,64,16,0" Canvas.ZIndex="5">
            <StackPanel Spacing="4" MinWidth="180">
                <TextBlock x:Name="OSDTitle" Foreground="{ThemeResource IimaTextBrush}" FontSize="20"/>
                <TextBlock x:Name="OSDDetail" Foreground="{ThemeResource IimaSecondaryTextBrush}"/>
                <ProgressBar x:Name="OSDProgress" Minimum="0" Maximum="1"/>
            </StackPanel>
        </Border>
        <Border x:Name="TopStatusBorder" Background="{ThemeResource IimaOverlayBackgroundBrush}" VerticalAlignment="Top" Padding="16">
            <TextBlock x:Uid="StatusText" x:Name="StatusText" Foreground="{ThemeResource IimaTextBrush}" TextWrapping="Wrap" />
        </Border>
        <Border x:Name="MusicHeader" Visibility="Collapsed" Canvas.ZIndex="6"
                Background="{ThemeResource IimaOverlayBackgroundBrush}" VerticalAlignment="Top" Margin="12,52,12,0" Padding="12">
            <StackPanel Spacing="4">
                <TextBlock x:Name="MusicTitleText" FontSize="20" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="MusicArtistText" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="MusicAlbumText" TextTrimming="CharacterEllipsis"/>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button x:Uid="MusicReturnButton" x:Name="MusicReturnButton"/>
                    <Button x:Uid="MusicPlaylistButton" x:Name="MusicPlaylistButton"/>
                    <Button x:Uid="MusicVolumeButton" x:Name="MusicVolumeButton" IsEnabled="False">
                        <Button.Flyout>
                            <Flyout x:Name="MusicVolumeFlyout" Placement="Bottom">
                                <StackPanel Spacing="8" Width="220">
                                    <TextBlock x:Uid="MusicVolumeValue" x:Name="MusicVolumeValue"/>
                                    <local:WheelSlider x:Uid="MusicVolumeSlider" x:Name="MusicVolumeSlider" Minimum="0" Maximum="100" SmallChange="1"
                                                       IsEnabled="False"/>
                                    <Button x:Uid="MusicMuteButton" x:Name="MusicMuteButton" IsEnabled="False"/>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
        <Border x:Name="ScreenshotPreviewBorder" Visibility="Collapsed" Canvas.ZIndex="9"
                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16,64,16,0"
                Background="{ThemeResource IimaOverlayBackgroundBrush}" Padding="8">
            <StackPanel Spacing="6">
                <TextBlock x:Uid="ScreenshotPreview" Foreground="{ThemeResource IimaTextBrush}"/>
                <Image x:Uid="ScreenshotPreviewImage" x:Name="ScreenshotPreviewImage" MaxWidth="300" MaxHeight="200" Stretch="Uniform"
/>
                <StackPanel x:Name="ScreenshotPreviewActions" Orientation="Horizontal" Spacing="6" Visibility="Collapsed">
                    <Button x:Uid="OpenScreenshotPreviewButton" x:Name="OpenScreenshotPreviewButton"/>
                    <Button x:Uid="RevealScreenshotPreviewButton" x:Name="RevealScreenshotPreviewButton"/>
                </StackPanel>
                <Button x:Uid="DismissScreenshotPreviewButton" x:Name="DismissScreenshotPreviewButton"/>
            </StackPanel>
        </Border>
        <Border x:Name="ThumbnailPreviewBorder" Visibility="Collapsed" Canvas.ZIndex="8" IsHitTestVisible="False"
                VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,100"
                Background="{ThemeResource IimaOverlayBackgroundBrush}" Padding="6">
            <StackPanel Spacing="4">
                <Image x:Name="ThumbnailPreviewImage" Visibility="Collapsed" Width="240" Height="135" Stretch="Uniform"/>
                <TextBlock x:Name="ThumbnailPreviewTime" HorizontalAlignment="Center" MaxWidth="320" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
        <Canvas x:Name="OscLayoutHost" Canvas.ZIndex="4">
        <Border x:Name="BottomControlsBorder" Background="{ThemeResource IimaOverlayBackgroundBrush}" Padding="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="4">
                <Thumb x:Uid="OscDragHandle" x:Name="OscDragHandle" Height="20" IsTabStop="False">
                    <Thumb.Template><ControlTemplate TargetType="Thumb">
                        <Border Background="{ThemeResource IimaOverlayBackgroundBrush}" CornerRadius="4">
                            <TextBlock x:Uid="DragControlBar" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate></Thumb.Template>
                </Thumb>
            <Grid ColumnSpacing="12" RowSpacing="6">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.ColumnSpan="4">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <local:WheelSlider x:Uid="PositionSlider" x:Name="PositionSlider" SmallChange="1" Minimum="0" Maximum="1"
                            IsEnabled="False" />
                    <Canvas x:Name="ChapterMarkers" IsHitTestVisible="False" FlowDirection="LeftToRight" Visibility="Collapsed" AutomationProperties.AccessibilityView="Raw"/>
                    <Canvas x:Name="ABLoopMarkers" Grid.Row="1" Height="24" Visibility="Collapsed">
                        <Thumb x:Uid="ABLoopThumbA" x:Name="ABLoopThumbA" IsTabStop="True" Width="24" Height="22">
                            <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{ThemeResource IimaOverlayBackgroundBrush}" CornerRadius="3"><TextBlock Text="A" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Thumb.Template>
                        </Thumb>
                        <Thumb x:Uid="ABLoopThumbB" x:Name="ABLoopThumbB" IsTabStop="True" Width="24" Height="22">
                            <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{ThemeResource IimaOverlayBackgroundBrush}" CornerRadius="3"><TextBlock Text="B" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Thumb.Template>
                        </Thumb>
                    </Canvas>
                </Grid>
                <Button x:Uid="OpenButton" x:Name="OpenButton" Grid.Row="1" />
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="4">
                    <Button x:Uid="OscLeftButton" x:Name="OscLeftButton" IsEnabled="False"/>
                    <Button x:Uid="PauseButton" x:Name="PauseButton" IsEnabled="False" />
                    <Button x:Uid="OscRightButton" x:Name="OscRightButton" IsEnabled="False"/>
                    <TextBlock x:Name="OscArrowSpeed" Width="64" MaxWidth="64" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock x:Name="TimeLabel" Foreground="{ThemeResource IimaTextBrush}" VerticalAlignment="Center" Text="--:--"/>
                    <TextBlock Text="/" VerticalAlignment="Center"/>
                    <Button x:Uid="TimeModeButton" x:Name="TimeModeButton" Content="--:--" Padding="4,2"/>
                </StackPanel>
                <ScrollViewer Grid.Row="2" Grid.ColumnSpan="4" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="OscToolbarItems" Orientation="Horizontal" Spacing="6">
                        <Button x:Uid="FullscreenButton" x:Name="FullscreenButton" Visibility="Collapsed"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
            </StackPanel>
            </ScrollViewer>
        </Border>
        </Canvas>
        <Border x:Name="PlayerSidebar" Grid.Column="1" Background="{ThemeResource IimaPanelBackgroundBrush}" Padding="12">
            <ContentControl x:Name="PlayerSidebarContent" IsTabStop="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="3*"/>
                    <RowDefinition Height="2*" MaxHeight="300"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock x:Uid="Playlist" Foreground="{ThemeResource IimaTextBrush}" VerticalAlignment="Center"/>
                    <Button x:Uid="AppendButton" x:Name="AppendButton"/>
                    <Button x:Uid="SavePlaylistButton" x:Name="SavePlaylistButton"/>
                </StackPanel>
                <ListView x:Uid="PlaylistView" x:Name="PlaylistView" Grid.Row="1" Foreground="{ThemeResource IimaTextBrush}" SelectionMode="Extended"
                          CanDragItems="True" AllowDrop="True" CanReorderItems="False"
 />
                <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button x:Uid="SortPlaylistButton" x:Name="SortPlaylistButton"/>
                            <Button x:Uid="ShufflePlaylistButton" x:Name="ShufflePlaylistButton"/>
                            <Button x:Uid="ClearPlaylistButton" x:Name="ClearPlaylistButton"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button x:Uid="PreviousButton" x:Name="PreviousButton"/>
                            <Button x:Uid="PlaySelectedButton" x:Name="PlaySelectedButton"/>
                            <Button x:Uid="NextButton" x:Name="NextButton"/>
                        </StackPanel>
                        <TextBlock x:Uid="PlaylistDurationSummary" x:Name="PlaylistDurationSummary" TextWrapping="Wrap" FontSize="12"/>
                        <TextBlock x:Uid="PlaylistDurationHint" x:Name="PlaylistDurationHint" TextWrapping="Wrap" FontSize="12"/>
                        <Button x:Uid="RefreshPlaylistDurationsButton" x:Name="RefreshPlaylistDurationsButton"/>
                        <TextBlock x:Uid="PlaylistSelectionText" x:Name="PlaylistSelectionText" TextWrapping="Wrap"/>
                        <Button x:Uid="DeletePlaylistFilesButton" x:Name="DeletePlaylistFilesButton"/>
                        <Button x:Uid="CancelPlaylistDeletionButton" x:Name="CancelPlaylistDeletionButton" IsEnabled="False"/>
                        <Button x:Uid="QueueSelectedNextButton" x:Name="QueueSelectedNextButton"/>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button x:Uid="RemoveButton" x:Name="RemoveButton"/>
                            <Button x:Uid="MoveUpButton" x:Name="MoveUpButton"/>
                            <Button x:Uid="MoveDownButton" x:Name="MoveDownButton"/>
                        </StackPanel>
                        <Button x:Uid="RevealPlaylistButton" x:Name="RevealPlaylistButton"/>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button x:Uid="CopyPlaylistPathsButton" x:Name="CopyPlaylistPathsButton"/>
                            <Button x:Uid="CopyPlaylistUrlsButton" x:Name="CopyPlaylistUrlsButton"/>
                        </StackPanel>
                        <Button x:Uid="PastePlaylistPathsButton" x:Name="PastePlaylistPathsButton"/>
                        <Button x:Uid="CancelPlaylistPasteButton" x:Name="CancelPlaylistPasteButton"/>
                        <Button x:Uid="CutPlaylistPathsButton" x:Name="CutPlaylistPathsButton"/>
                        <Button x:Uid="PlaySelectedNewWindowButton" x:Name="PlaySelectedNewWindowButton" IsEnabled="False"/>
                        <Button x:Uid="OpenPlaylistBrowserButton" x:Name="OpenPlaylistBrowserButton" IsEnabled="False"
/>
                        <Expander x:Uid="SubtitleAssociationsForTheSelectedItem" HorizontalAlignment="Stretch">
                            <StackPanel Spacing="6">
                                <TextBlock x:Uid="PlaylistSubtitleAssociationStatus" x:Name="PlaylistSubtitleAssociationStatus" TextWrapping="Wrap"/>
                                <ListView x:Uid="PlaylistSubtitleAssociationList" x:Name="PlaylistSubtitleAssociationList" MaxHeight="120" SelectionMode="None"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                                <Button x:Uid="AddPlaylistSubtitleAssociationButton" x:Name="AddPlaylistSubtitleAssociationButton" IsEnabled="False"/>
                                <Button x:Uid="ClearPlaylistSubtitleAssociationButton" x:Name="ClearPlaylistSubtitleAssociationButton" IsEnabled="False"/>
                                <TextBlock x:Uid="OnlyIndividualLocalMediaEntriesAreSupported" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Expander>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button x:Uid="NewWindowButton" x:Name="NewWindowButton"/>
                            <Button x:Uid="NextWindowButton" x:Name="NextWindowButton"/>
                        </StackPanel>
                        <TextBlock x:Uid="WindowCountText" x:Name="WindowCountText"/>
                        <Button x:Uid="RevealFileButton" x:Name="RevealFileButton"/>
                        <Button x:Uid="MusicModeButton" x:Name="MusicModeButton"/>
                        <Button x:Uid="CompactOverlayButton" x:Name="CompactOverlayButton"/>
                        <Button x:Uid="OpenUrlButton" x:Name="OpenUrlButton"/>
                        <DropDownButton x:Uid="MoreOpens">
                            <DropDownButton.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem x:Uid="OpenFileAlternativeItem" x:Name="OpenFileAlternativeItem"/>
                                    <MenuFlyoutItem x:Uid="OpenFolderItem" x:Name="OpenFolderItem"/>
                                    <MenuFlyoutItem x:Uid="OpenFolderAlternativeItem" x:Name="OpenFolderAlternativeItem"/>
                                    <MenuFlyoutItem x:Uid="AppendFolderItem" x:Name="AppendFolderItem"/>
                                    <MenuFlyoutSeparator/>
                                    <MenuFlyoutItem x:Uid="OpenUrlAlternativeItem" x:Name="OpenUrlAlternativeItem"/>
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button x:Uid="RelativeSeekBackButton" x:Name="RelativeSeekBackButton"/>
                            <Button x:Uid="RelativeSeekForwardButton" x:Name="RelativeSeekForwardButton"/>
                            <Button x:Uid="StepBackButton" x:Name="StepBackButton"/>
                            <Button x:Uid="StepForwardButton" x:Name="StepForwardButton"/>
                        </StackPanel>
                        <TextBlock x:Name="ABLoopLabel" Text="A: --:--  B: --:--"/>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button x:Uid="ABLoopButton" x:Name="ABLoopButton"/>
                            <Button x:Uid="ClearABLoopButton" x:Name="ClearABLoopButton"/>
                        </StackPanel>
                        <Expander x:Uid="ABPeerAdjustment" HorizontalAlignment="Stretch">
                            <StackPanel Spacing="6">
                                <TextBlock x:Uid="SetTheEndpointsWithABLoop" TextWrapping="Wrap"/>
                                <Button x:Uid="LoadABDraftButton" x:Name="LoadABDraftButton"/>
                                <NumberBox x:Uid="ABPointABox" x:Name="ABPointABox" Minimum="0" SpinButtonPlacementMode="Compact"/>
                                <Button x:Uid="ApplyABPointAButton" x:Name="ApplyABPointAButton"/>
                                <NumberBox x:Uid="ABPointBBox" x:Name="ABPointBBox" Minimum="0" SpinButtonPlacementMode="Compact"/>
                                <Button x:Uid="ApplyABPointBButton" x:Name="ApplyABPointBButton"/>
                                <TextBlock x:Name="ABEditStatus" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Expander>
                        <ComboBox x:Uid="VideoTrackBox" x:Name="VideoTrackBox" HorizontalAlignment="Stretch"/>
                        <Button x:Uid="CycleVideoTrackButton" x:Name="CycleVideoTrackButton"/>
                        <Button x:Uid="LoadExternalVideoButton" x:Name="LoadExternalVideoButton" IsEnabled="False"/>
                        <Button x:Uid="CancelExternalVideoButton" x:Name="CancelExternalVideoButton" IsEnabled="False"/>
                        <TextBlock x:Name="ExternalVideoStatus" TextWrapping="Wrap" FontSize="12"/>
                        <Button x:Uid="CycleAudioTrackButton" x:Name="CycleAudioTrackButton"/>
                        <ComboBox x:Uid="AudioBox" x:Name="AudioBox" HorizontalAlignment="Stretch"/>
                        <Button x:Uid="LoadExternalAudioButton" x:Name="LoadExternalAudioButton" IsEnabled="False"/>
                        <Button x:Uid="CancelExternalAudioButton" x:Name="CancelExternalAudioButton" IsEnabled="False"/>
                        <TextBlock x:Name="ExternalAudioStatus" TextWrapping="Wrap" FontSize="12"/>
                        <ComboBox x:Uid="AudioEqualizerBox" x:Name="AudioEqualizerBox" HorizontalAlignment="Stretch"/>
                        <Button x:Uid="ApplyAudioEqualizerButton" x:Name="ApplyAudioEqualizerButton"/>
                        <Button x:Uid="RemoveAudioEqualizerButton" x:Name="RemoveAudioEqualizerButton"/>
                        <Expander x:Uid="Customize10ParagraphBalance" HorizontalAlignment="Stretch">
                            <StackPanel Spacing="6">
                                <StackPanel x:Name="EqualizerBandsPanel" Spacing="4"/>
                                <Button x:Uid="LoadObservedEqualizerButton" x:Name="LoadObservedEqualizerButton"/>
                                <Button x:Uid="ApplyCustomEqualizerButton" x:Name="ApplyCustomEqualizerButton"/>
                                <ComboBox x:Uid="UserEqualizerBox" x:Name="UserEqualizerBox"/>
                                <Button x:Uid="LoadUserEqualizerButton" x:Name="LoadUserEqualizerButton"/>
                                <TextBox x:Uid="UserEqualizerName" x:Name="UserEqualizerName" MaxLength="256"/>
                                <Button x:Uid="SaveUserEqualizerButton" x:Name="SaveUserEqualizerButton"/>
                                <Button x:Uid="RenameUserEqualizerButton" x:Name="RenameUserEqualizerButton"/>
                                <Button x:Uid="DeleteUserEqualizerButton" x:Name="DeleteUserEqualizerButton"/>
                            </StackPanel>
                        </Expander>
                        <Button x:Uid="CycleSubtitleTrackButton" x:Name="CycleSubtitleTrackButton"/>
                        <ComboBox x:Uid="SubtitleBox" x:Name="SubtitleBox" HorizontalAlignment="Stretch"/>
                        <Expander x:Uid="SecondarySubtitles" HorizontalAlignment="Stretch">
                            <StackPanel Spacing="6">
                                <ComboBox x:Uid="SecondarySubtitleBox" x:Name="SecondarySubtitleBox" HorizontalAlignment="Stretch"/>
                                <CheckBox x:Uid="SecondarySubtitlesVisibleCheck" x:Name="SecondarySubtitlesVisibleCheck" IsThreeState="True"/>
                                <TextBlock x:Name="SecondarySubtitleStatus" TextWrapping="Wrap"/>
                                <Button x:Uid="LoadSecondarySubtitleButton" x:Name="LoadSecondarySubtitleButton"/>
                                <NumberBox x:Uid="SecondarySubtitleDelayBox" x:Name="SecondarySubtitleDelayBox" Value="0" SmallChange="0.1"/>
                                <NumberBox x:Uid="SecondarySubtitlePositionBox" x:Name="SecondarySubtitlePositionBox" Minimum="0" Maximum="150" Value="0"/>
                                <NumberBox x:Uid="SecondarySubtitleScaleBox" x:Name="SecondarySubtitleScaleBox" Minimum="0" Maximum="100" Value="1" SmallChange="0.1"/>
                                <Button x:Uid="ApplySecondarySubtitleButton" x:Name="ApplySecondarySubtitleButton" IsEnabled="False"/>
                                <Button x:Uid="ResetSecondaryDelayButton" x:Name="ResetSecondaryDelayButton"/>
                                <TextBlock x:Uid="ParametersWillNotBeAutomaticallyOverwritedIn" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Expander>
                        <TextBlock x:Name="SubtitleStyleWarning" TextWrapping="Wrap"/>
                        <Button x:Uid="SubtitleButton" x:Name="SubtitleButton"/>
                        <Button x:Uid="MatchSubtitleButton" x:Name="MatchSubtitleButton"/>
                        <Expander x:Uid="OnlineSubtitleExpander" x:Name="OnlineSubtitleExpander" HorizontalAlignment="Stretch">
                            <StackPanel Spacing="6">
                                <TextBlock x:Uid="SearchToSendQueryWordsLanguageAnd" TextWrapping="Wrap"/>
                                <ComboBox x:Uid="OnlineSubtitleProviderBox" x:Name="OnlineSubtitleProviderBox" SelectedIndex="0">
                                    <ComboBoxItem Content="Assrt (api.assrt.net)"/>
